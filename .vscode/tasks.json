{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "shell",
			"command": "npm run start",
			"isBackground": true,
			"problemMatcher": {
				"owner": "custom",
				"pattern": {
					"regexp": "^$"
				},
				"background": {
					"activeOnStart": true,
					"beginsPattern": "npm run.*",
					"endsPattern": ".*compiled successfully.*"
				}
			},
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"label": "start https",
			"detail": "webpack-dev-server --https",
			"options": {
				"env": {
					"NODE_ENV": "development",
					"XCRATCH_EXTENSION_COLLECTOR_URL": "https://asia-northeast1-xcratch-extension-collector.cloudfunctions.net/recordXCX-recordXCX"
				}
			}
		}
	]
}